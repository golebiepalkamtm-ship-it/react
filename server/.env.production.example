# Backend (Railway) – ustaw jako Variables, nie commituj prawdziwych wartości
PORT=8001

# Supabase (DB + Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_BUCKET=auction-media
SUPABASE_BUCKET_PUBLIC=true
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_SECRET_KEYS=sb_secret_placeholder

# Database (Supabase Postgres URI)
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
DIRECT_URL=postgresql://postgres:password@host:5432/postgres

# Auth / JWT
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# App / CORS
CLIENT_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
NODE_ENV=production
NODE_VERSION=22.22.0

# Stripe (wymagane jeśli moduł płatności aktywny)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Twilio (wymagane jeśli weryfikacja SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+48123123123
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxx

# Prisma deploy (jeśli używasz migrate deploy)
PRISMA_MIGRATE_DEPLOY=true
