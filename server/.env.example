# Server (Express + Prisma + Supabase)

# Środowisko
NODE_ENV=development
PORT=8001
CLIENT_URL=http://localhost:5173

# Baza Danych (Postgres / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/champion_pigeon?pgbouncer=false
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/champion_pigeon?pgbouncer=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (klucz publiczny frontendu)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (klucz serwerowy, min. 200 znaków)
SUPABASE_BUCKET=auctions (nazwa bucketa Supabase Storage)
SUPABASE_BUCKET_PUBLIC=auctions-public (bucket publiczny)

# Auth (JWT) - jeśli używane dla własnych endpointów
JWT_SECRET=replace_me_in_prod
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Twilio (SMS Notifications & Verification)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Stripe (Płatności)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here (klucz sekretny Stripe)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here (sekret webhooka Stripe)
