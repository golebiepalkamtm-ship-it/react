# Backend Production Environment
# UWAGA: Ten plik zawiera przykładowe wartości. W produkcji ustaw rzeczywiste wartości jako zmienne środowiskowe.

# Środowisko
NODE_ENV=production
PORT=8001
CLIENT_URL=https://www.palkamtm.pl

# Baza Danych (Supabase Postgres)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
SHADOW_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase
SUPABASE_URL=https://nctvwxiqzbedgcmetyal.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5jdHZ3eGlxemJlZGdjbWV0eWFsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjY0Nzk2NDUsImV4cCI6MjA4MjA1NTY0NX0.A3ie8bcvSZeXclTKgMyh5L3uz_LPTjlHz95isEQ3kJQ
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
SUPABASE_BUCKET=auction-images
SUPABASE_BUCKET_PUBLIC=auction-public

# JWT (dla własnych endpointów)
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Twilio (SMS Verification)
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_API_KEY=REPLACE_WITH_TWILIO_API_KEY
TWILIO_API_SECRET=REPLACE_WITH_TWILIO_API_SECRET
TWILIO_VERIFY_SERVICE_SID=REPLACE_WITH_TWILIO_VERIFY_SERVICE_SID
TWILIO_PHONE_NUMBER=REPLACE_WITH_TWILIO_PHONE_NUMBER

# Stripe (Płatności)
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
STRIPE_CURRENCY=pln

# Security & Performance
ALLOWED_ORIGINS=https://www.palkamtm.pl,https://palkamtm.pl,https://champion-pigeon-web.onrender.com
CORS_MAX_AGE=86400
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm

# Redis (opcjonalnie - dla rate limiting)
# REDIS_URL=redis://user:password@host:port
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
