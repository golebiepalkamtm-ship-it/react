generator client {
  // JS client with client engine (no Rust binary)
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuctionStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum AuctionCategory {
  RACING
  BREEDING
  SHOW
}

enum Sex {
  MALE
  FEMALE
}

enum UserRole {
  USER_REGISTERED
  USER_EMAIL_VERIFIED
  USER_FULL_VERIFIED
  ADMIN
}

model User {
  /// Map to existing Supabase table "users"
  @@map("users")
  id          String   @id @db.Uuid
  email       String?  @unique
  phone       String?
  username    String   @unique
  name        String?
  first_name  String?
  last_name   String?
  street      String?
  postal_code String?
  city        String?
  country     String?
  avatar_url  String?
  role        String   @db.Text @default("USER_REGISTERED")
  trustScore  Decimal  @map("trust_score") @default(0.00) @db.Decimal(3,2)
  createdAt   DateTime @map("created_at") @default(now())
  updatedAt   DateTime @map("updated_at") @updatedAt
  auctions    Auction[] @relation("SellerAuctions")
  wonAuctions Auction[] @relation("WinnerAuctions")
  bids        Bid[]
  watchlist   Watchlist[]
  notifications Notification[]
  reviewsGiven Review[] @relation("ReviewerReviews")
  reviewsReceived Review[] @relation("RevieweeReviews")
  savedSearches SavedSearch[]
  payments     Payment[]
}

model Auction {
  /// Map to existing Supabase table "auctions"
  @@map("auctions")
  id                    String   @id @default(uuid()) @db.Uuid
  title                 String
  description           String?
  startingPrice         Decimal? @map("starting_price") @db.Decimal(12, 2)
  currentPrice          Decimal  @map("current_price") @db.Decimal(12, 2)
  buyNowPrice           Decimal? @map("buy_now_price") @db.Decimal(12, 2)
  reservePrice          Decimal? @map("reserve_price") @db.Decimal(12, 2)
  endTime               DateTime @map("ends_at") @db.Timestamptz
  snipeThresholdMinutes Int      @map("snipe_threshold_minutes") @default(5)
  snipeExtensionMinutes Int      @map("snipe_extension_minutes") @default(5)
  minBidIncrement       Int      @map("min_bid_increment") @default(100)
  status                AuctionStatus   @default(ACTIVE)
  reserveMet            Boolean         @map("reserve_met") @default(false)
  category              AuctionCategory @default(RACING)
  sex                   Sex             @default(MALE)
  location              String
  createdAt             DateTime @map("created_at") @default(now())
  updatedAt             DateTime @map("updated_at") @updatedAt
  winnerId              String?  @map("winner_id")

  sellerId              String   @map("owner_id")
  seller                User     @relation("SellerAuctions", fields: [sellerId], references: [id])
  winner                User?    @relation("WinnerAuctions", fields: [winnerId], references: [id])

  pigeon                PigeonProfile?

  bids                  Bid[]
  images                AuctionImage[]
  videos                AuctionVideo[]
  documents             AuctionDocument[]
  watchlist             Watchlist[]
  notifications         Notification[]
  reviews               Review[]
  payments              Payment[]

  @@index([status])
  @@index([endTime])
  @@index([category])
  @@index([sellerId])
  @@index([winnerId])
}

model Bid {
  @@map("bids")
  id         String   @id @default(uuid()) @db.Uuid
  auctionId  String   @map("auction_id")
  bidderId   String   @map("bidder_id")
  amount     Decimal  @db.Decimal(12, 2)
  isProxy    Boolean  @map("is_proxy") @default(false)
  maxBid     Decimal? @map("max_bid") @db.Decimal(12, 2)
  createdAt  DateTime @map("created_at") @default(now())

  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder     User     @relation(fields: [bidderId], references: [id], onDelete: SetNull)

  @@index([auctionId, createdAt])
  @@index([bidderId])
}

model Watchlist {
  @@map("watchlists")
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id")
  auctionId  String   @map("auction_id")
  createdAt  DateTime @map("created_at") @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([userId, auctionId])
  @@index([userId])
  @@index([auctionId])
}

model PigeonProfile {
  @@map("pigeon_profiles")
  id            String   @id @default(uuid()) @db.Uuid
  auctionId     String   @unique @map("auction_id")
  ringNumber   String   @map("ringnumber")
  construction  String?  @map("construction")
  eyeColor      String?  @map("eye_color")
  featherColor  String?  @map("feather_color")
  vitality      String?
  length        String?
  endurance     String?
  forkStrength  String?  @map("fork_strength")
  forkAlignment String?  @map("fork_alignment")
  muscles       String?
  balance       String?
  back          String?
  purpose       String?
  gender        String   @db.Text
  createdAt     DateTime @map("created_at") @default(now())
  updatedAt     DateTime @map("updated_at") @updatedAt

  auction       Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
}

model AuctionImage {
  @@map("auction_images")
  id         String   @id @default(uuid()) @db.Uuid
  auctionId  String   @map("auction_id")
  url        String
  ordering   Int?
  createdAt  DateTime @map("created_at") @default(now())

  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId])
}

model AuctionVideo {
  @@map("auction_videos")
  id         String   @id @default(uuid()) @db.Uuid
  auctionId  String   @map("auction_id")
  url        String
  createdAt  DateTime @map("created_at") @default(now())

  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId])
}

model AuctionDocument {
  @@map("auction_documents")
  id         String   @id @default(uuid()) @db.Uuid
  auctionId  String   @map("auction_id")
  url        String
  createdAt  DateTime @map("created_at") @default(now())

  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId])
}

enum NotificationType {
  OUTBID
  AUCTION_WON
  AUCTION_ENDING
  BID_PLACED
}

model Notification {
  @@map("notifications")
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  auctionId String?  @map("auction_id")
  type      String   @db.Text
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction   Auction? @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([auctionId])
  @@index([read])
  @@index([type])
}

model Review {
  @@map("reviews")
  id         String   @id @default(uuid()) @db.Uuid
  auctionId  String   @map("auction_id")
  reviewerId String   @map("reviewer_id")
  revieweeId String   @map("reviewee_id")
  rating     Int
  comment    String?
  createdAt  DateTime @map("created_at") @default(now())
  updatedAt  DateTime @map("updated_at") @updatedAt

  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  reviewer   User     @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee   User     @relation("RevieweeReviews", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([auctionId, reviewerId])
  @@index([auctionId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@index([rating])
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentProvider {
  PAYPAL
  P24
  STRIPE
}

enum PaymentType {
  BUY_NOW
  LISTING_FEE
  COMMISSION
}

model Payment {
  @@map("payments")
  id             String          @id @default(uuid()) @db.Uuid
  auctionId      String          @map("auction_id")
  userId         String          @map("user_id")
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("PLN")
  provider       PaymentProvider
  type           PaymentType
  status         PaymentStatus   @default(INITIATED)
  externalId     String?         @map("external_id")
  approvalUrl    String?         @map("approval_url")
  rawResponse    Json?           @map("raw_response")
  createdAt      DateTime        @map("created_at") @default(now())
  updatedAt      DateTime        @map("updated_at") @updatedAt

  auction        Auction         @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([auctionId])
  @@index([userId])
  @@index([status])
  @@index([provider])
}

model SavedSearch {
  @@map("saved_searches")
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  name      String
  filters   Json     // Store search filters as JSON
  isActive  Boolean  @map("is_active") @default(true)
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}
