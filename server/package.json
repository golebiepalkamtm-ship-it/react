{
  "name": "auction-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Champion Pigeon Auctions",
  "main": "dist/bootstrap.js",
  "scripts": {
    "dev": "node --no-deprecation node_modules/nodemon/bin/nodemon.js --watch . --ext ts --exec \"tsx\" index.ts",
    "create-admin": "node ./scripts/create-admin.js",
    "create-user": "node ./scripts/create-user.js",
    "build": "prisma generate && tsc --skipLibCheck && node ./scripts/copy-runtime.js",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "seed:json": "tsx scripts/seed-from-json.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@dr.pogodin/csurf": "^1.16.8",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@prisma/config": "^7.4.2",
    "@supabase/supabase-js": "^2.39.0",
    "ai": "5.0.52",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-sync": "^4.2.1",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^6.11.2",
    "express-session": "^1.19.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.1.1",
    "pg": "^8.11.3",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.0.0",
    "socket.io": "^4.7.2",
    "stripe": "^16.3.0",
    "twilio": "^5.11.2",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "overrides": {
    "fast-xml-parser": "5.4.2"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/csurf": "1.11.5",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.0.1",
    "prisma": "^7.4.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.1.6"
  }
}
