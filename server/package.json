{
  "name": "auction-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Champion Pigeon Auctions",
  "main": "dist/bootstrap.js",
  "scripts": {
    "dev": "nodemon --watch . --ext ts --exec \"tsx\" index.ts",
    "create-admin": "node ./scripts/create-admin.js",
    "create-user": "node ./scripts/create-user.js",
    "build": "prisma generate && tsc --skipLibCheck && node ./scripts/copy-runtime.js",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "seed:json": "tsx scripts/seed-from-json.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.2",
    "@prisma/client": "6.19.2",
    "@supabase/supabase-js": "^2.39.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/csurf": "^1.11.5",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.2.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "prisma": "6.19.2",
    "rate-limit-redis": "^4.3.1",
    "redis": "^4.6.13",
    "socket.io": "^4.7.2",
    "stripe": "^16.3.0",
    "twilio": "^5.11.2",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/redis": "^4.6.13",
    "nodemon": "^3.0.1",
    "ts-node": "^1.7.1",
    "tsx": "^4.21.0",
    "typescript": "^5.1.6"
  }
}
