{
  "name": "auction-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Champion Pigeon Auctions",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch . --ext ts --exec \"tsx\" index.ts",
    "create-admin": "node ./scripts/create-admin.js",
    "build": "npx prisma generate && tsc",
    "start": "node dist/server/index.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.2",
    "twilio": "^5.11.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "nodemon": "^3.0.1",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.1.6"
  }
}
