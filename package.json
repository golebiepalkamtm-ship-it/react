{
  "name": "champion-pigeon-auctions",
  "scripts": {
    "preinstall": "npm config set ignore-scripts true",
    "dev:client": "node --no-deprecation node_modules/vite/bin/vite.js",
    "dev:server": "npm --prefix server run dev",
    "dev": "node --no-deprecation node_modules/concurrently/dist/bin/concurrently.js -k -n FRONTEND,BACKEND -c \"blue,green\" \"npm:dev:client\" \"npm:dev:server\"",
    "dev:all": "npm run dev",
    "build": "vite build && npm run copy-render-config",
    "start": "serve -s dist -l 3000",
    "copy-render-config": "node -e \"require('fs').copyFileSync('public/_redirects', 'dist/_redirects')\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"server/**/*.{ts,js}\" --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix --ext .ts,.tsx,.js,.jsx",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=github",
    "snyk:test": "snyk code test --exclude=\"public,.kilocode,supabase-mcp,server/tests,server/test-auth.ts,server/test-db.js\" || exit 0",
    "snyk:monitor": "snyk monitor || exit 0",
    "audit": "npm audit --audit-level=moderate",
    "prisma:generate": "prisma generate --schema=./server/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./server/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./server/prisma/schema.prisma",
    "supabase:db:push": "supabase db push",
    "migrate": "npm run prisma:generate && supabase db push"
  },
