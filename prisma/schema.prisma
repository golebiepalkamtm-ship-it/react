generator client {
  // JS client with client engine (no Rust binary)
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER_REGISTERED
  USER_EMAIL_VERIFIED
  USER_FULL_VERIFIED
  ADMIN
}

model User {
  id        String   @id @db.Uuid
  email     String?  @unique
  phone     String?
  name      String?
  role      UserRole @default(USER_REGISTERED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}