# Production Environment Variables
# Copy this file to .env.production and fill in your actual values

# Frontend Environment Variables (for Vercel)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=https://champion-pigeon-auctions-backend.onrender.com

# Backend Environment Variables (for Render/Railway)
NODE_ENV=production
PORT=10000

# Database
DATABASE_URL=postgresql://username:password@host:5432/database

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication
JWT_SECRET=your-very-secure-jwt-secret-min-32-chars

# Twilio (SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Frontend URL (for CORS and redirects)
FRONTEND_URL=https://champion-pigeon-auctions.vercel.app

# Upload Configuration
UPLOAD_PATH=/opt/uploads
MAX_FILE_SIZE=10485760
