{
  "version": 2,
  "installCommand": "npm_config_ignore_scripts=1 NPM_CONFIG_IGNORE_SCRIPTS=1 npm install --ignore-scripts",
  "buildCommand": "npm run build",
  "env": {
    "NPM_CONFIG_IGNORE_SCRIPTS": "1",
    "npm_config_ignore_scripts": "1"
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.palkamtm.pl/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "palkamtm.pl"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "https://www.palkamtm.pl/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "golebiepalkamtm-ship-it-react.vercel.app"
        }
      ]
    }
  ]
}
