{
  "version": 2,
  "installCommand": "npm_config_ignore_scripts=1 NPM_CONFIG_IGNORE_SCRIPTS=1 npm install --ignore-scripts",
  "buildCommand": "npm run build",
  "env": {
    "NPM_CONFIG_IGNORE_SCRIPTS": "1",
    "npm_config_ignore_scripts": "1"
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://server-production-0e43.up.railway.app/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://server-production-0e43.up.railway.app/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.palkamtm.pl/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "palkamtm.pl"
        }
      ]
    }
  ]
}
