SUPABASE_SERVICE_ROLE_KEY=

# OAuth: Google
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=183183722536-g2chsiob74janho7mtuopk12c7fm239t.apps.googleusercontent.com

# Supabase CLI Twilio integration
