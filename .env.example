# Example environment variables for local development
# Client (Vite) - public keys
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server - keep these secrets out of client bundles and git
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SERVER ONLY - use platform secrets

# Optional (local Supabase CLI endpoints)
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=anon-local-key

# SMS provider (if using SMS OTP). Choose provider and set corresponding tokens.
# Twilio example:
# SUPABASE_AUTH_SMS_PROVIDER=twilio
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=your-twilio-auth-token
# MESSAGEBIRD example:
# SUPABASE_AUTH_SMS_PROVIDER=messagebird
# SUPABASE_AUTH_SMS_MESSAGEBIRD_KEY=your-messagebird-key
# Environment Variables
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=http://localhost:8000

# Supabase (frontend)
VITE_SUPABASE_URL=https://nctvwxiqzbedgcmetyal.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Auth redirect (optional)
# If unset, the app uses window.location.origin and redirects email verification links to /verify-email
#VITE_SITE_URL=http://localhost:5173
#VITE_AUTH_REDIRECT_URL=http://localhost:5173/verify-email

# Firebase Configuration (Replace with your project values)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX